# Compose 项目名（容器名前缀）
COMPOSE_PROJECT_NAME=water-leak
# 前端端口（nginx 静态站点）
FRONTEND_PORT=20105
# 后端端口（Spring Boot，容器内部 8080）
BACKEND_PORT=21105
# PostgreSQL 宿主机映射端口
DB_PORT=54320
# 数据库连接信息（docker-compose 与后端共用）
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=app_password
# JWT 签名密钥（本地开发默认值，生产请替换）
JWT_SECRET=local-dev-secret
